:: Copia este archivo a .env.bat para personalizar sin editar start.bat
:: start.bat lo carga automaticamente si existe

set DB_HOST=localhost
set DB_PORT=3306
set DB_NAME=votaciones
set DB_USER=root
set DB_PASSWORD=12345
set APP_PORT=8080

