# Copia este archivo a .env y ajusta los valores
# El docker-compose usa estas variables (con los defaults indicados si no están definidas)

DB_NAME=votaciones
DB_USER=root
DB_PASSWORD=12345
DB_PORT=3307        # puerto en el host para MySQL (3307 evita conflicto con MySQL local en 3306)

APP_PORT=8080       # puerto en el host para el backend
FRONTEND_PORT=4200  # puerto en el host para el frontend (cuando esté habilitado)

# JWT — CAMBIAR en producción: openssl rand -base64 64
JWT_SECRET=c2VjcmV0b3NlZ3Vyb3BhcmF2b3RhY2lvbmVzZW50aWVtcG9yZWFsMTIzNDU2Nzg=
JWT_EXPIRATION_MS=86400000
